{
  "name": "axiom-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Axiom — 个人外脑前端。第一阶段 Web，第二阶段 Tauri 原生壳",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test:atlas-study": "node --experimental-strip-types --test tests/atlas-study.test.ts",
    "test:atlas-study:browser": "node tests/run-atlas-study-browser.mjs",
    "test:atlas-study:spatial": "node tests/run-atlas-study-browser.mjs --spatial",
    "build:atlas-study": "vue-tsc --noEmit && vite build --config vite.atlas-study.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@lucide/vue": "^1.33.0",
    "@types/three": "^0.184.1",
    "d3-force-3d": "3.0.6",
    "d3-polygon": "3.0.1",
    "pinia": "^2.2.6",
    "three": "^0.184.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.6.3",
    "vite": "^7.3.6",
    "vue-tsc": "^2.1.10"
  }
}
