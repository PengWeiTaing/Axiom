        "assertions": [
          {"type": "demo_field", "kind": "constrained_extremum_2d", "path": "data.constraint.radius", "numeric_equals": 1, "tolerance": 1e-9},
          {"type": "demo_field", "kind": "constrained_extremum_2d", "path": "data.objective.coefficients", "numeric_sequence_equals": [1, 2], "tolerance": 1e-9},
          {"type": "demo_field", "kind": "constrained_extremum_2d", "path": "data.extremum", "equals_normalized_any": ["maximum"]}
        ]
      }
    },
