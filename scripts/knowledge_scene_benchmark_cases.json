        {"id": "necessary-condition", "description": "梯度平行只给出候选必要条件", "all": ["(必要条件|候选条件|候选点)", "(比较|验证|判定)"], "none": ["梯度平行[^。；]{0,24}(充分条件|必然是极值)"]}
