    {
      "id": "M01",
      "domain": "数学",
      "goal": "从差商推导 f(x)=x² 在 x₀=1 处的导数，并用割线趋于切线解释 h→0；只保留概念关键步，不展开基础分配律。",
      "source_text": "",
      "subject_terms": ["数学", "微积分", "高等数学"],
      "target_text_any": [["差商", "割线"], ["切线", "瞬时变化率"]],
      "correctness": [
        {"id": "difference-quotient", "description": "差商化为 2+h", "any": ["2\\s*\\+\\s*h", "h\\s*\\+\\s*2"]},
        {"id": "derivative-value", "description": "导数或极限等于 2", "any": ["(导数|斜率|极限)[^。；]{0,24}(等于|为|=)\\s*2(?![0-9.])", "f['′]?\\s*\\(?1\\)?\\s*=\\s*2(?![0-9.])"]},
        {"id": "no-early-zero", "description": "不能在差商仍含除以 h 时直接令 h=0", "none": ["(直接|先)令\\s*h\\s*=\\s*0[^。；]{0,30}(差商|除)"]}
      ],
      "demo_policy": {
        "mode": "required",
        "required_all": ["limit_microscope"],
        "allowed": ["limit_microscope", "equation_morph"],
        "learning_action": "观察割线斜率随 h 缩小而逼近切线斜率",
        "assertions": [
          {"type": "demo_field", "kind": "limit_microscope", "path": "data.expression", "equals_normalized_any": ["x^2"]},
          {"type": "demo_field", "kind": "limit_microscope", "path": "data.x0", "numeric_equals": 1, "tolerance": 1e-9}
        ]
      }
    },
    {
      "id": "M02",
      "domain": "数学",
      "goal": "用黎曼和解释 ∫₀^π sin(x)dx，并说明 n 增大、Δx 减小时矩形和为什么趋于定积分。",
      "source_text": "",
      "subject_terms": ["数学", "微积分", "高等数学"],
      "target_text_any": [["黎曼和", "矩形和"], ["sin", "正弦"]],
      "correctness": [
        {"id": "integral-value", "description": "积分值为 2", "any": ["(积分值|定积分|结果)[^。；]{0,30}(等于|为|=)\\s*2(?![0-9.])", "(?:∫|\\\\int)[^。；]{0,100}=\\s*2(?![0-9.])", "lim[^。；]{0,40}S[^。；]{0,20}=\\s*2(?![0-9.])"]},
        {"id": "convergence", "description": "说明 n 增大、Δx 减小和收敛", "all": ["n", "(Δx|delta\\s*x|\\\\Delta\\s*x)", "(趋近|逼近|收敛)"]},
        {"id": "no-wrong-function", "description": "不得把本题替换成 x²", "none": ["x[²^]2[^。；]{0,30}(黎曼|积分|矩形)", "(黎曼|积分|矩形)[^。；]{0,30}x[²^]2"]}
      ],
      "demo_policy": {
        "mode": "required",
        "required_all": ["riemann_sum"],
        "forbidden": ["function_plot"],
        "learning_action": "观察矩形和随分割数收敛",
        "assertions": [
          {"type": "demo_field", "kind": "riemann_sum", "path": "data.expression", "equals_normalized_any": ["sin(x)"]},
          {"type": "demo_field", "kind": "riemann_sum", "path": "data.domain", "numeric_sequence_equals": [0, 3.141592653589793], "tolerance": 0.01}
        ]
      }
    },
    {
      "id": "M03",
      "domain": "数学",
      "goal": "某病患病率为1%，检测灵敏度95%，健康者误报率5%。用贝叶斯公式求检测阳性后真正患病的概率，并解释基率作用。",
      "source_text": "",
      "subject_terms": ["数学", "概率", "概率论", "统计"],
