        "assertions": [
          {"type": "demo_text_any", "kind_any": ["probability_bars", "concept_map"], "patterns": ["16\\.0?1?", "0\\.161", "后验", "真正患病"]}
        ]
      }
    },
    {
      "id": "M04",
      "domain": "数学",
      "goal": "在单位圆 x²+y²=1 上最大化 f=x+2y，给出拉格朗日乘数法的几何解释、候选点和比较结论。",
