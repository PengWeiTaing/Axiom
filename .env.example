# Axiom receiver runtime config
# Use this as the template for /opt/axiom/.env on the VPS.

AXIOM_ROOT=/opt/axiom
AXIOM_ARCHIVE_PATH=/opt/axiom/data/archive
AXIOM_SECRET_KEY=change-me
AXIOM_HOST=0.0.0.0
AXIOM_PORT=5000
AXIOM_LOG_LEVEL=INFO
AXIOM_LOG_PATH=/opt/axiom/logs/receiver.log
AXIOM_MAX_UPLOAD_BYTES=20971520
AXIOM_AUDIO_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AXIOM_AUDIO_TRANSCRIBE_LANGUAGE=zh
AXIOM_AUDIO_TRANSCRIBE_TIMEOUT_SECONDS=300
AXIOM_IMAGE_DESCRIBE_MODEL=gpt-4.1-mini
AXIOM_IMAGE_DESCRIBE_TIMEOUT_SECONDS=300
# AXIOM_IMAGE_DESCRIBE_PROMPT=请用中文写 1 到 3 句客观描述
# AXIOM_OPENAI_API_KEY=

# 火山杯 Axiom 学习白板：扣子工作流（服务端专用，勿提交真实令牌）
# COZE_API_TOKEN=
# COZE_WORKFLOW_ID=<published-workflow-id>
# COZE_API_BASE=https://api.coze.cn
# COZE_TIMEOUT_SECONDS=300
# FIRECUP_WORKFLOW_REVISION=v0.0.7

# 火山杯公开生成网关（仅服务端；Origin 必须写完整协议和域名，不支持 *）
# FIRECUP_ALLOWED_ORIGINS=https://your-competition-app.example
# FIRECUP_GATEWAY_BIND=127.0.0.1:5010
# FIRECUP_CACHE_TTL_SECONDS=900
# FIRECUP_CACHE_MAX_ENTRIES=64
# FIRECUP_INFLIGHT_WAIT_SECONDS=330
# FIRECUP_MAX_REQUEST_BYTES=65536
# FIRECUP_JOB_TTL_SECONDS=1800
# FIRECUP_JOB_MAX_ENTRIES=128
# FIRECUP_JOB_QUEUE_MAX_ENTRIES=8
# FIRECUP_JOB_DB_PATH=/var/lib/axiom/firecup-jobs.sqlite3
